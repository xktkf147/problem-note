PORT=3000

# Supabase 대시보드 Connect > Session pooler(포트 5432) 연결 문자열을 넣는다.
# ?sslmode= 는 붙이지 않는다. 비밀번호가 들어가므로 .env는 절대 커밋하지 않는다.
DATABASE_URL=postgresql://postgres.<프로젝트ref>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres

# 시험용 임시 스키마를 쓸 때만 켠다(예: smoke). 비워 두면 기본 public 스키마를 쓴다.
# DATABASE_SCHEMA=smoke
